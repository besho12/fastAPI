# Active LLM provider. Use "gemini" only as a temporary rollback option.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_REQUEST_TIMEOUT_SECONDS=90
OPENAI_MAX_OUTPUT_TOKENS=16000

# Gemini settings (required only when LLM_PROVIDER=gemini).
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_COMPARISON_TIMEOUT_SECONDS=90

DATABASE_URL=
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
